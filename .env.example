# Copy to `.env` and adjust as needed. All values have sane defaults in the compose
# file, so an empty .env (or none) also works.

# --- Postgres (shared by control-plane + studio-backend) ---
POSTGRES_DB=gargantua
POSTGRES_USER=gargantua
POSTGRES_PASSWORD=gargantua

# --- MinIO (bundle manifest blobs) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gargantua-bundles

# --- Published host ports ---
CONTROL_PLANE_PORT=8080
STUDIO_BACKEND_PORT=8090
STUDIO_PORT=8081
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
