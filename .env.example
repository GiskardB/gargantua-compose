# Copy to `.env` and adjust as needed. All values have sane defaults in the compose
# file, so an empty .env (or none) also works.

# --- Postgres (shared by control-plane + studio-backend) ---
POSTGRES_DB=gargantua
POSTGRES_USER=gargantua
POSTGRES_PASSWORD=gargantua

# --- MinIO (bundle manifest blobs) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gargantua-bundles

# --- Published host ports ---
# Deliberately in a high range so they never clash with Cave's own services
# (forgejo 3000, 3001, postgres 5432, redis 6379, cave-publish 7443, 8080, minio 9000/9001).
# Only these host-side ports change; the container-internal ports are unchanged.
CONTROL_PLANE_PORT=18080
STUDIO_BACKEND_PORT=18090
STUDIO_PORT=18081
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# --- Optional `agent-runtime` profile (actually running a bundle, via local Ollama) ---
OLLAMA_PORT=19434
RUNTIME_PORT=18100
# Any Ollama tag; small ones keep the pull/CPU-inference fast for a demo.
OLLAMA_MODEL=qwen2.5:0.5b
